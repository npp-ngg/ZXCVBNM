<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <jp.zxcvbnm.CandidateTextView
        android:id="@+id/candidate_text"
        android:layout_width="0dp"
        android:layout_height="@dimen/candidate_height"
        android:background="@color/main_color"
        android:clickable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn1" />
    <Button
        android:id="@+id/btn1"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="40dp"
        android:layout_height="@dimen/candidate_height"
        android:background="@drawable/rectangle"
        android:alpha="0.4"
        android:clickable="false"
        android:padding="0dp"
        android:textAllCaps="false"
        android:textSize="@dimen/keyborad_text_size"
        app:layout_constraintLeft_toRightOf="@id/candidate_text"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/candidate_text"
        app:layout_constraintBottom_toBottomOf="@id/candidate_text" />
</androidx.constraintlayout.widget.ConstraintLayout>